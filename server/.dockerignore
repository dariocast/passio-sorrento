# =============================================================================
# Docker build context — ignored files
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# Database files (built at runtime)
instance/
*.db
*.sqlite

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation (not needed in image)
AGENTS.md
docs/

# Distribution
dist/
build/
*.egg-info/
